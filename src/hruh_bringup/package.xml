<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hruh_bringup</name>
  <version>0.1.0</version>
  <description>Top-level launch files for the HRUH humanoid: Gazebo simulation, mock-hardware demo and kinematic RViz walking, each with MoveIt and gamepad control.</description>
  <maintainer email="shreyaspatel0456@gmail.com">shreyas</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>my_robot_description</exec_depend>
  <exec_depend>hruh_control</exec_depend>
  <exec_depend>hruh_moveit_config</exec_depend>
  <exec_depend>hruh_teleop</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
