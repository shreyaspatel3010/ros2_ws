<launch>
    <let name="urdf_path" 
         value="$(find-pkg-share my_robot_description)/urdf/my_robot.urdf.xacro" />
    <let name="rviz_config_path"
         value="$(find-pkg-share my_robot_description)/rviz/urdf_config.rviz" />

    <node pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui" />

    <let name="gazebo_config_path"
         value="$(find-pkg-share my_robot_description)/config/gazebo_bridge.yaml" />


    <node pkg="robot_state_publisher" exec="robot_state_publisher">
            <param name="robot_description"
                   value="$(command 'xacro $(var urdf_path)')" />
    </node>
     <node pkg="controller_manager" exec="ros2_control_node" output="screen">
          <param name="robot_description"
                    value="$(command 'xacro $(var urdf_path)')" />
          <param from="$(find-pkg-share my_robot_description)/config/ros2_controllers.yaml" />
     </node>

     <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="$(find-pkg-share my_robot_description)/worlds/test_world.sdf -r" />
    </include>

    <node pkg="ros_gz_sim" exec="create" args="-topic robot_description -entity my_robot" />

    <node pkg="ros_gz_bridge" exec="parameter_bridge">
        <param name="config_file" value="$(var gazebo_config_path)" />
    </node>
    <!-- <include file="$(find-pkg-share gazebo_ros)/launch/gazebo.launch.py" >
     <arg name="world" value="$(find-pkg-share my_robot_description)/worlds/my_world.world" />
    </include> -->

    <!-- <include file="$(find-pkg-share my_robot_description)/launch/cartographer.launch.py" >
     <arg name="use_sim_time" value="True" />
    </include>

    <include file="$(find-pkg-share my_robot_description)/launch/online_async_launch.py" >
     <arg name="use_sim_time" value="True" />
    </include>

    <include file="$(find-pkg-share my_robot_description)/launch/navigation2.launch.py" >
     <arg name="use_sim_time" value="True" />
    </include> -->

    <!-- <node pkg="gazebo_ros" exec="spawn_entity.py"
          args="-topic robot_description -entity my_robot" /> -->
    <node pkg="rviz2" exec="rviz2" output="screen" 
          args="-d $(var rviz_config_path)" />
    
   
    
</launch>
