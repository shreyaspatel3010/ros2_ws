<?xml version="1.0"?>
<!--
  HRUH lower body: pelvis + two 7-DOF legs.

  Kinematics follow the human leg:
    hip   : yaw (z) -> roll (x) -> pitch (y), all three axes meet at the hip centre (ball joint).
            The actuators sit along their own axes where they physically fit (blender HIP):
            yaw motor inside the pelvis above the hip, roll motor behind the hip centre,
            pitch motor outside the thigh. Link masses / centres of mass follow the motors.
    knee  : pitch (y), flexion positive
    ankle : pitch (y) -> roll (x), axes meet at the ankle centre
    toe   : pitch (y) hinge at the ball of the foot (heel-to-toe roll-off)
  Joint ranges are human ranges of motion (degrees in comments).
  Frames: x forward, y left, z up.  Meshes: meshes/legs (generated by blender/build_parts.py).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Geometry (keep in sync with KIN in blender/build_parts.py) -->
  <xacro:property name="hip_y"        value="0.105"/>  <!-- 0.085 let the thighs collide -->
  <xacro:property name="hip_yaw_z"    value="-0.03"/>
  <xacro:property name="hip_roll_z"   value="-0.06"/>
  <xacro:property name="thigh_length" value="0.34"/>
  <xacro:property name="shin_length"  value="0.34"/>
  <xacro:property name="ankle_height" value="0.065"/>
  <xacro:property name="toe_x"        value="0.125"/>
  <xacro:property name="toe_z"        value="-0.045"/>
  <!-- pelvis frame height when standing with straight legs -->
  <xacro:property name="pelvis_standing_height"
                  value="${ankle_height + shin_length + thigh_length - hip_roll_z - hip_yaw_z}"/>

  <xacro:property name="leg_mesh_dir" value="package://my_robot_description/meshes/legs"/>

  <!-- Solid-body inertia helpers (the ones in common_properties.xacro are kept
       unchanged for the existing links) -->
  <xacro:macro name="solid_box_inertial" params="m x y z ox:=0 oy:=0 oz:=0">
    <inertial>
      <origin xyz="${ox} ${oy} ${oz}" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12.0}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12.0}" iyz="0" izz="${m*(x*x+y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="solid_cyl_inertial" params="m r h ox:=0 oy:=0 oz:=0">
    <inertial>
      <origin xyz="${ox} ${oy} ${oz}" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12.0}" ixy="0" ixz="0"
               iyy="${m*(3*r*r+h*h)/12.0}" iyz="0" izz="${m*r*r/2.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="mesh_visual" params="file">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${leg_mesh_dir}/${file}"/></geometry>
    </visual>
  </xacro:macro>

  <!-- ===================== Pelvis ===================== -->
  <!-- base_link is the floating root (pelvis frame).  It carries no inertia so
       KDL / robot_state_publisher are happy; the pelvis body hangs off it. -->
  <link name="base_link"/>

  <link name="pelvis_link">
    <xacro:mesh_visual file="pelvis.obj"/>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.18 0.30 0.09"/></geometry>
    </collision>
    <!-- shell, battery and both hip-yaw actuators -->
    <xacro:solid_box_inertial m="9.0" x="0.18" y="0.30" z="0.10" oz="0.015"/>
  </link>

  <joint name="base_pelvis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="pelvis_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="imu_frame"/>
  <joint name="imu_joint" type="fixed">
    <parent link="pelvis_link"/>
    <child link="imu_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ===================== Leg ===================== -->
  <!-- side: left|right, s: +1 (left) / -1 (right) -->
  <xacro:macro name="hruh_leg" params="side s">

    <!-- Hip yaw: internal/external rotation 40 / 43 deg (one leg reaches its mechanism limit at 45;
         both feet toed out > 21 deg make the rear roll actuators touch: self-collision) -->
    <joint name="${side}_hip_yaw_joint" type="revolute">
      <parent link="pelvis_link"/>
      <child link="${side}_hip_yaw_link"/>
      <origin xyz="0 ${s*hip_y} ${hip_yaw_z}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-0.70 if s > 0 else -0.75}" upper="${0.75 if s > 0 else 0.70}" effort="150" velocity="8.0"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>
    <link name="${side}_hip_yaw_link">
      <xacro:mesh_visual file="${side}_hip_yaw.obj"/>
      <!-- carries the hip roll actuator, 13 cm behind the hip centre -->
      <collision>
        <origin xyz="-0.130 0 ${hip_roll_z}" rpy="0 ${pi/2} 0"/>
        <geometry><cylinder radius="0.050" length="0.055"/></geometry>
      </collision>
      <xacro:solid_cyl_inertial m="2.7" r="0.05" h="0.06" ox="-0.115" oz="-0.055"/>
    </link>

    <!-- Hip roll: abduction 31 deg / adduction 24 deg. Measured on the meshes (blender/design check):
         the pitch actuator meets the pelvis at 33 deg abduction; the hip itself allows 25 deg
         adduction (the other leg may be touched before that: self-collision) -->
    <joint name="${side}_hip_roll_joint" type="revolute">
      <parent link="${side}_hip_yaw_link"/>
      <child link="${side}_hip_roll_link"/>
      <origin xyz="0 0 ${hip_roll_z}" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="${-0.42 if s > 0 else -0.54}" upper="${0.54 if s > 0 else 0.42}" effort="200" velocity="8.0"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>
    <link name="${side}_hip_roll_link">
      <xacro:mesh_visual file="${side}_hip_roll.obj"/>
      <!-- carries the hip pitch actuator, outside the thigh -->
      <collision>
        <origin xyz="0 ${s*0.080} 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="0.056" length="0.050"/></geometry>
      </collision>
      <xacro:solid_box_inertial m="2.9" x="0.12" y="0.10" z="0.11" ox="-0.02" oy="${s*0.07}"/>
    </link>

    <!-- Hip pitch: flexion 89 deg (negative) / extension 29 deg (positive). The thigh meets the
         hip-yaw link at 91.6 deg flexion and the roll actuator / pelvis at 30 deg extension -->
    <joint name="${side}_hip_pitch_joint" type="revolute">
      <parent link="${side}_hip_roll_link"/>
      <child link="${side}_thigh_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.55" upper="0.50" effort="250" velocity="8.0"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>
    <link name="${side}_thigh_link">
      <xacro:mesh_visual file="${side}_thigh.obj"/>
      <collision>
        <origin xyz="0.005 0 ${-thigh_length*0.47}" rpy="0 0 0"/>
        <geometry><cylinder radius="0.050" length="${thigh_length*0.68}"/></geometry>
      </collision>
      <!-- structure + knee actuator at the bottom -->
      <xacro:solid_cyl_inertial m="4.3" r="0.055" h="${thigh_length}" oz="${-thigh_length*0.55}"/>
    </link>

    <!-- Knee: flexion 0..140 deg -->
    <joint name="${side}_knee_joint" type="revolute">
      <parent link="${side}_thigh_link"/>
      <child link="${side}_shin_link"/>
      <origin xyz="0 0 ${-thigh_length}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0.0" upper="2.44" effort="300" velocity="10.0"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>
    <link name="${side}_shin_link">
      <xacro:mesh_visual file="${side}_shin.obj"/>
      <collision>
        <origin xyz="-0.008 0 ${-shin_length*0.5}" rpy="0 0 0"/>
        <geometry><cylinder radius="0.045" length="${shin_length*0.66}"/></geometry>
      </collision>
      <xacro:solid_cyl_inertial m="3.0" r="0.045" h="${shin_length}" ox="-0.01" oz="${-shin_length*0.38}"/>
    </link>

    <!-- Ankle pitch: dorsiflexion 30 deg (negative) / plantarflexion 50 deg (positive) -->
    <joint name="${side}_ankle_pitch_joint" type="revolute">
      <parent link="${side}_shin_link"/>
      <child link="${side}_ankle_link"/>
      <origin xyz="0 0 ${-shin_length}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-0.52" upper="0.87" effort="150" velocity="10.0"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>
    <link name="${side}_ankle_link">
      <xacro:mesh_visual file="${side}_ankle.obj"/>
      <xacro:solid_box_inertial m="0.4" x="0.04" y="0.06" z="0.04"/>
    </link>

    <!-- Ankle roll: inversion 35 deg / eversion 20 deg -->
    <joint name="${side}_ankle_roll_joint" type="revolute">
      <parent link="${side}_ankle_link"/>
      <child link="${side}_foot_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="${-0.61 if s > 0 else -0.35}" upper="${0.35 if s > 0 else 0.61}" effort="100" velocity="10.0"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>
    <link name="${side}_foot_link">
      <xacro:mesh_visual file="${side}_foot.obj"/>
      <!-- flat sole box: heel to the ball of the foot -->
      <collision>
        <origin xyz="${(toe_x - 0.073)/2.0} ${-s*0.003} ${-ankle_height + 0.012}" rpy="0 0 0"/>
        <geometry><box size="${toe_x + 0.073} 0.098 0.024"/></geometry>
      </collision>
      <xacro:solid_box_inertial m="1.1" x="0.2" y="0.09" z="0.05" ox="0.025" oz="-0.04"/>
    </link>

    <!-- Toe: extension 60 deg (negative, roll-off) / flexion 20 deg -->
    <joint name="${side}_toe_joint" type="revolute">
      <parent link="${side}_foot_link"/>
      <child link="${side}_toe_link"/>
      <origin xyz="${toe_x} 0 ${toe_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.05" upper="0.35" effort="40" velocity="10.0"/>
      <dynamics damping="0.3" friction="0.05"/>
    </joint>
    <link name="${side}_toe_link">
      <xacro:mesh_visual file="${side}_toe.obj"/>
      <collision>
        <origin xyz="0.028 ${-s*0.006} ${-(ankle_height + toe_z) + 0.009}" rpy="0 0 0"/>
        <geometry><box size="0.054 0.088 0.018"/></geometry>
      </collision>
      <xacro:solid_box_inertial m="0.2" x="0.06" y="0.09" z="0.02" ox="0.028"/>
    </link>

    <gazebo reference="${side}_foot_link">
      <mu1>1.5</mu1>
      <mu2>1.5</mu2>
    </gazebo>
    <gazebo reference="${side}_toe_link">
      <mu1>1.5</mu1>
      <mu2>1.5</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:hruh_leg side="left" s="1"/>
  <xacro:hruh_leg side="right" s="-1"/>

</robot>
