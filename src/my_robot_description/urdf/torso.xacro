<?xml version="1.0"?>
<!--
  HRUH torso: rigid. The chest is bolted to the pelvis through a lumbar block
  (no waist joints). A 3-DOF waist with all axes in one point could not be built
  (no room for three 150-200 N m actuators), and the walking policy is meant to
  balance with the legs while the upper body stays still.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="waist_z" value="0.09"/>   <!-- lumbar block (torso_link) above the pelvis frame -->
  <xacro:property name="chest_z" value="0.04"/>   <!-- chest_hruh origin above torso_link -->

  <joint name="torso_fixed_joint" type="fixed">
    <parent link="pelvis_link"/>
    <child link="torso_link"/>
    <origin xyz="0 0 ${waist_z}" rpy="0 0 0"/>
  </joint>
  <link name="torso_link">
    <visual>
      <geometry><mesh filename="package://my_robot_description/meshes/legs/waist.obj"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.005" rpy="0 0 0"/>
      <geometry><box size="0.14 0.19 0.07"/></geometry>
    </collision>
    <!-- lumbar housing (electronics) -->
    <xacro:solid_box_inertial m="3.0" x="0.14" y="0.19" z="0.07"/>
  </link>

</robot>
