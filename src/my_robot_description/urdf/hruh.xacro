<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="hruh">

  <!--
    Chest, neck and head.  chest_hruh (and everything above it) faces -x in its
    own frame, so it is mounted on the torso with a 180 deg yaw.
    Textured meshes: meshes/chest/chest_v2.obj and meshes/head/head_v2.obj
    (generated by blender/build_parts.py).  Visuals carry no <material> so
    RViz / Gazebo use the baked textures.
  -->

  <xacro:property name="neck_pitch_z" value="0.07"/>  <!-- nod pivot above chest_to_neck -->

  <!-- Chest -->
  <link name="chest_hruh">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://my_robot_description/meshes/chest/chest_v2.obj"/>
      </geometry>
    </visual>
    <!-- primitive collisions kept inside the arms' sweep -->
    <collision>
      <origin xyz="-0.005 0 0.2" rpy="0 0 0" />
      <geometry><box size="0.18 0.22 0.22"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0" />
      <geometry><box size="0.14 0.17 0.1"/></geometry>
    </collision>
    <xacro:solid_box_inertial m="9.0" x="0.18" y="0.24" z="0.36" oz="0.18"/>
  </link>
  <joint name="arm_chest_joint" type="fixed">
      <parent link="torso_link" />
      <child link="chest_hruh" />
      <origin xyz="0 0 ${chest_z}" rpy="0 0 ${pi}" />
  </joint>

  <gazebo reference="chest_hruh">
      <selfCollide>true</selfCollide>
      <mu>1.1</mu>
      <mu2>1.1</mu2>
  </gazebo>

  <!-- Neck: rotation (yaw) +-80 deg -->
  <joint name="chest_to_neck" type="revolute">
    <parent link="chest_hruh"/>
    <child link="neck"/>
    <origin xyz="0 0 0.3723" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="1" friction="2"/>
    <limit lower="-1.4" upper="1.4" effort="500" velocity="1.0"/>
  </joint>

  <link name="neck">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/neck/neck_v2.obj"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/neck/neck.STL" scale="1 1 1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.0008"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </inertial>
  </link>

  <gazebo reference="neck">
      <selfCollide>true</selfCollide>
  </gazebo>

  <!-- Head nod (pitch): positive = look up (extension 60 deg), negative = look down (flexion 50 deg).
       The head frame faces -x, so +y here is the robot's right. -->
  <joint name="neck_to_head" type="revolute">
    <parent link="neck"/>
    <child link="head_base"/>
    <origin xyz="0 0 ${neck_pitch_z}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="1" friction="2"/>
    <limit lower="-0.87" upper="1.05" effort="500" velocity="1.0"/>
  </joint>

  <link name="head_base">
    <visual>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/head/head_v2.obj"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.005 0 0.08" rpy="0 0 0"/>
      <geometry><cylinder radius="0.075" length="0.16"/></geometry>
    </collision>
    <xacro:solid_cyl_inertial m="1.8" r="0.075" h="0.2" oz="0.08"/>
  </link>

</robot>
