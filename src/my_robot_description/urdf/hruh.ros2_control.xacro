<?xml version="1.0"?>
<!--
  ros2_control for every actuated joint of HRUH.

  hardware:=gz    Gazebo Sim (gz_ros2_control), the default
  hardware:=mock  mock_components/GenericSystem: commands are echoed back as
                  state, for MoveIt / RViz without a simulator
  hardware:=none  no ros2_control (e.g. joint_state_publisher_gui display)

  Controllers: config/ros2_controllers.yaml
    legs_controller        14 leg joints, streamed by hruh_walker
    waist_controller       3-DOF waist        (JointTrajectoryController)
    head_controller        neck yaw + nod     (JointTrajectoryController)
    left/right_arm_controller   5 joints each (MoveIt, servo, joystick)
    left/right_hand_controller 15 joints each (open / close grasp)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="hardware" default="gz"/>
  <xacro:property name="hardware" value="$(arg hardware)"/>

  <xacro:property name="hruh_leg_joints" value="${[s + '_' + j + '_joint' for s in ['left', 'right'] for j in ['hip_yaw', 'hip_roll', 'hip_pitch', 'knee', 'ankle_pitch', 'ankle_roll', 'toe']]}"/>
  <xacro:property name="hruh_upper_joints" value="${['waist_yaw_joint', 'waist_roll_joint', 'waist_pitch_joint', 'chest_to_neck', 'neck_to_head']
      + ['chest_to_left_shoulder', 'left_shoulder_to_bisecp', 'left_bisecp_to_elbow_inword', 'left_elbow_inword_to_midle', 'left_forarm_to_wrist',
         'chest_to_right_shoulder', 'right_shoulder_to_bisecp', 'right_bisecp_to_elbow_inword', 'right_elbow_inword_to_midle', 'right_forarm_to_wrist']
      + [s + '_' + n for s in ['left', 'right'] for n in ['palm_to_thomb', 'thomb_to_thomb_middle', 'thomb_middle_to_thomb_upper']
                                                         + ['palm_to_finger%d_lower' % i for i in [1, 2, 3, 4]]
                                                         + ['finger%d_lower_to_finger%d_middle' % (i, i) for i in [1, 2, 3, 4]]
                                                         + ['finger%d_middle_to_finger%d_upper' % (i, i) for i in [1, 2, 3, 4]]]}"/>

  <xacro:macro name="hruh_ctrl_joint" params="name">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="hruh_ctrl_joints" params="names">
    <xacro:if value="${len(names) > 0}">
      <xacro:hruh_ctrl_joint name="${names[0]}"/>
      <xacro:hruh_ctrl_joints names="${names[1:]}"/>
    </xacro:if>
  </xacro:macro>

  <xacro:unless value="${hardware == 'none'}">
    <ros2_control name="HruhSystem" type="system">
      <hardware>
        <xacro:if value="${hardware == 'gz'}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
        <xacro:if value="${hardware == 'mock'}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">false</param>
        </xacro:if>
      </hardware>
      <xacro:hruh_ctrl_joints names="${hruh_leg_joints + hruh_upper_joints}"/>
    </ros2_control>
  </xacro:unless>

  <xacro:if value="${hardware == 'gz'}">
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find my_robot_description)/config/ros2_controllers.yaml</parameters>
      </plugin>
    </gazebo>
  </xacro:if>

</robot>
