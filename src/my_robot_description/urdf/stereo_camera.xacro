<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="baseline" value="0.064"/>  <!-- human inter-pupillary distance (64 mm) -->
  <!-- eye cameras sit in the head's eye sockets; head_base faces -x, robot-left is -y -->
  <xacro:property name="eye_x" value="-0.080"/>
  <xacro:property name="eye_z" value="0.085"/>
  <xacro:property name="cam_w" value="1024"/>
  <xacro:property name="cam_h" value="1024"/>
  <xacro:property name="fov"   value="1.3962634"/> <!-- ~80° -->

  <!-- Left eye camera (in the head) -->
  <link name="stereo_left"/>
  <joint name="stereo_left_joint" type="fixed">
    <parent link="head_base"/>
    <child  link="stereo_left"/>
    <origin xyz="${eye_x} ${-baseline/2.0} ${eye_z}" rpy="0 0 ${pi}"/>
  </joint>

  <!-- Left optical frame (Z forward, X right, Y down) -->
  <link name="stereo_left_optical"/>
  <joint name="stereo_left_optical_joint" type="fixed">
    <parent link="stereo_left"/>
    <child  link="stereo_left_optical"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- Right eye camera (in the head) -->
  <link name="stereo_right"/>
  <joint name="stereo_right_joint" type="fixed">
    <parent link="head_base"/>
    <child  link="stereo_right"/>
    <origin xyz="${eye_x} ${baseline/2.0} ${eye_z}" rpy="0 0 ${pi}"/>
  </joint>

  <!-- Right optical frame -->
  <link name="stereo_right_optical"/>
  <joint name="stereo_right_optical_joint" type="fixed">
    <parent link="stereo_right"/>
    <child  link="stereo_right_optical"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- Cameras for gz (Ionic) -->
  <xacro:if value="${enable_stereo_cameras}">
    <gazebo reference="stereo_left">
      <sensor type="camera" name="left">
        <always_on>true</always_on>
        <update_rate>60</update_rate>
        <gz_frame_id>stereo_left_optical</gz_frame_id>
        <topic>/stereo/left/image_raw</topic>
        <camera_info_topic>/stereo/left/camera_info</camera_info_topic>
        <camera>
          <horizontal_fov>${fov}</horizontal_fov>
          <image><width>${cam_w}</width><height>${cam_h}</height><format>R8G8B8</format></image>
          <clip><near>0.3</near><far>20</far></clip>
        </camera>
      </sensor>
    </gazebo>

    <gazebo reference="stereo_right">
      <sensor type="camera" name="right">
        <always_on>true</always_on>
        <update_rate>60</update_rate>
        <gz_frame_id>stereo_right_optical</gz_frame_id>
        <topic>/stereo/right/image_raw</topic>
        <camera_info_topic>/stereo/right/camera_info</camera_info_topic>
        <camera>
          <horizontal_fov>${fov}</horizontal_fov>
          <image><width>${cam_w}</width><height>${cam_h}</height><format>R8G8B8</format></image>
          <clip><near>0.3</near><far>20</far></clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:if>
</robot>
