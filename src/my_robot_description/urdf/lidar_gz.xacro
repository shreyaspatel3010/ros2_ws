<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- simple mast link for LiDAR -->
  <link name="lidar_link">
    <!-- <visual>
      <geometry><cylinder radius="0.035" length="0.06"/></geometry>
      <material name="grey"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.035" length="0.06"/></geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial> -->
  </link>

  <!-- LiDAR is built into the crown of the head (optical centre of the ring
       window); head_base faces -x so the sensor is yawed 180 deg to look forward -->
  <joint name="head_to_lidar" type="fixed">
    <parent link="head_base"/>
    <child link="lidar_link"/>
    <origin xyz="0.010 0.0 0.178" rpy="0 0 ${pi}"/>
  </joint>

  <!-- Gazebo Sim LiDAR sensor -->
  <xacro:if value="${enable_lidar}">
    <gazebo reference="lidar_link">
      <sensor name="gpu_lidar" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <topic>/lidar</topic>
        <update_rate>60</update_rate>

        <!-- 360° horizontal + a few vertical beams -> 3D point cloud -->
        <ray>
          <scan>
            <horizontal>
              <samples>1024</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle> 3.14159</max_angle>
            </horizontal>
            <!-- 64 beams from -30 deg to +15 deg (like a 3D spinning LiDAR);
                 a full +-180 deg vertical sweep from the crown would mostly hit the robot itself -->
            <vertical>
              <samples>64</samples>
              <resolution>1</resolution>
              <min_angle>-0.5236</min_angle>
              <max_angle> 0.2618</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.12</min>  <!-- ignore returns from the head itself -->
            <max>45.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>

        <!-- Frame on messages; optional but nice to be explicit -->
        <gz_frame_id>lidar_link</gz_frame_id>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </gazebo>
  </xacro:if>
</robot>
