        <mesh filename="file:///home/shreyas/ros2_ws/src/my_robot_description/meshes/left_arm/left_elbow_midle.stl" scale="0.15 0.15 0.15"/>
      </geometry>
    </collision>
    
    <inertial>
      <mass value="0.6"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.0018" iyz="0.0" izz="0.0015"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </inertial>
  </link>

  <gazebo reference="left_elbow_midle">
      <selfCollide>true</selfCollide>
  </gazebo>

  <!-- Left elbow outword Joint -->
  <joint name="left_elbow_midle_to_outword" type="fixed">
    <parent link="left_elbow_midle"/>
    <child link="Left_elbow_outword"/>
    <origin xyz="0 -0.0175 0" rpy="0 0 0"/>
    <axis xyz="0 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="500" velocity="1.0"/>
  </joint>

  <link name="Left_elbow_outword">
    <visual>
      <geometry>
        <mesh filename="file:///home/shreyas/ros2_ws/src/my_robot_description/meshes/left_arm/Left_elbow_outword.stl" scale="0.15 0.15 0.15"/>
      </geometry>
      <material name="grey" />
