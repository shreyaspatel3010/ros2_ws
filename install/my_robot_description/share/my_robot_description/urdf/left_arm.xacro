  <!-- Left forarm upper to lower Joint -->
  <joint name="left_forarm_upper_to_lower_1" type="fixed">
    <parent link="left_elbow_to_forarm_upper"/>
    <child link="Left_forarm_lower_1"/>
    <origin xyz="0 0 -0.04" rpy="0 0 0"/>
    <axis xyz="0 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="500" velocity="1.0"/>
  </joint>

  <link name="Left_forarm_lower_1">
