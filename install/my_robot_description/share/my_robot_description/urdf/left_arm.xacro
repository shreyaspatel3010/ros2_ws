  <!-- Left forarm internal support -->
  <joint name="left_forarm_lower_1_to_internal_support" type="fixed">
    <parent link="Left_forarm_lower_1"/>
    <child link="Left_forarm_internal_support"/>
    <origin xyz="0 -0.001 -0.05185" rpy="0 0 0"/>
    <axis xyz="0 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="500" velocity="1.0"/>
  </joint>

  <link name="Left_forarm_internal_support">
