<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="hruh">


  <!-- Left Shoulder Joint -->
  <joint name="chest_to_left_shoulder" type="revolute">
    <parent link="chest_hruh"/>
    <child link="left_shoulder"/>
    <origin xyz="0 -0.104 0.315" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="1" friction="2"/>
    <limit lower="-1.57" upper="3.14" effort="500" velocity="1.0"/>
  </joint>

  <link name="left_shoulder">
    <visual>
      <geometry>
        <mesh filename="file:///home/shreyas/ros2_ws/src/my_robot_description/meshes/left_arm/left_S_to_C.stl" scale="0.15 0.15 0.15"/>
      </geometry>
      <material name="grey" />
    </visual>
    <collision>
      <geometry>
        <mesh filename="file:///home/shreyas/ros2_ws/src/my_robot_description/meshes/left_arm/left_S_to_C.stl" scale="0.15 0.15 0.15"/>
      </geometry>
    </collision>
    
    <inertial>
      <mass value="1.2"/>
      <inertia ixx="0.004" ixy="0.0" ixz="0.0" iyy="0.004" iyz="0.0" izz="0.003"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </inertial>
  </link>

  <gazebo reference="left_shoulder">
      <selfCollide>true</selfCollide>
  </gazebo>


 
  <!-- Left S to bisecp Arm Joint -->
  <joint name="left_shoulder_to_bisecp" type="revolute">
    <parent link="left_shoulder"/>
    <child link="left_S_to_Bisecp"/>
    <origin xyz="0.01 -0.0795 0.02" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <dynamics damping="1" friction="2"/>
    <limit lower="-1.57" upper="0.45" effort="500" velocity="1.0"/>
  </joint>

  <link name="left_S_to_Bisecp">
    <visual>
      <geometry>
        <mesh filename="file:///home/shreyas/ros2_ws/src/my_robot_description/meshes/left_arm/left_S_to_Bisecp.stl" scale="0.15 0.15 0.15"/>
      </geometry>
      <material name="grey" />
    </visual>
    <collision>
      <geometry>
        <mesh filename="file:///home/shreyas/ros2_ws/src/my_robot_description/meshes/left_arm/left_S_to_Bisecp.stl" scale="0.15 0.15 0.15"/>
      </geometry>
    </collision>
    
    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.005" ixy="0.0" ixz="0.0" iyy="0.0045" iyz="0.0" izz="0.0035"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </inertial>
  </link>

  <gazebo reference="left_S_to_Bisecp">
      <selfCollide>true</selfCollide>
  </gazebo>

  <!-- Left Bisecp uper Joint -->
  <joint name="left_S_to_bisecp_upper" type="fixed">
    <parent link="left_S_to_Bisecp"/>
    <child link="left_bisecp_upper"/>
    <origin xyz="-0.007 0.0025 -0.095" rpy="0 0 0"/>
    <axis xyz="0 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="500" velocity="1.0"/>
  </joint>

  <link name="left_bisecp_upper">
    <visual>
      <geometry>
        <mesh filename="file:///home/shreyas/ros2_ws/src/my_robot_description/meshes/left_arm/Left_bisecp_uper.stl" scale="0.15 0.15 0.15"/>
      </geometry>
      <material name="grey" />
    </visual>
    <collision>
      <geometry>
        <mesh filename="file:///home/shreyas/ros2_ws/src/my_robot_description/meshes/left_arm/Left_bisecp_uper.stl" scale="0.15 0.15 0.15"/>
      </geometry>
    </collision>
    
    <inertial>
      <mass value="0.9"/>
      <inertia ixx="0.003" ixy="0.0" ixz="0.0" iyy="0.0025" iyz="0.0" izz="0.002"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </inertial>
  </link>

  <gazebo reference="left_bisecp_upper">
      <selfCollide>true</selfCollide>
  </gazebo>

  <!-- Left Bisecp lower Joint -->
  <joint name="left_bisecp_uper_to_lower" type="fixed">
    <parent link="left_bisecp_upper"/>
    <child link="left_bisecp_lower"/>
    <origin xyz="0 0 -0.042" rpy="0 0 0"/>
    <axis xyz="0 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="500" velocity="1.0"/>
  </joint>

  <link name="left_bisecp_lower">
    <visual>
      <geometry>
        <mesh filename="file:///home/shreyas/ros2_ws/src/my_robot_description/meshes/left_arm/left_Bisecp_lower.stl" scale="0.15 0.15 0.15"/>
      </geometry>
      <material name="grey" />
    </visual>
    <collision>
      <geometry>
        <mesh filename="file:///home/shreyas/ros2_ws/src/my_robot_description/meshes/left_arm/left_Bisecp_lower.stl" scale="0.15 0.15 0.15"/>
      </geometry>
    </collision>
    
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.0025" ixy="0.0" ixz="0.0" iyy="0.0025" iyz="0.0" izz="0.0018"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </inertial>
    
  </link>

  

  <gazebo reference="left_bisecp_lower">
      <selfCollide>true</selfCollide>
  </gazebo>

  <!-- Left elbow inword Joint -->
  <joint name="left_bisecp_to_elbow_inword" type="revolute">
    <parent link="left_bisecp_lower"/>
    <child link="left_elbow_inword"/>
    <origin xyz="0. 0 -0.12" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="1" friction="2"/>
    <limit lower="-1.57" upper="1.57" effort="500" velocity="1.0"/>
  </joint>

  <link name="left_elbow_inword">
    <visual>
      <geometry>
        <mesh filename="file:///home/shreyas/ros2_ws/src/my_robot_description/meshes/left_arm/left_elbow_inword.stl" scale="0.15 0.15 0.15"/>
      </geometry>
      <material name="grey" />
    </visual>
    <collision>
      <geometry>
        <mesh filename="file:///home/shreyas/ros2_ws/src/my_robot_description/meshes/left_arm/left_elbow_inword.stl" scale="0.15 0.15 0.15"/>
      </geometry>
    </collision>
    
    <inertial>
      <mass value="0.6"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.0018" iyz="0.0" izz="0.0015"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </inertial>
  </link>

  <gazebo reference="left_elbow_inword">
      <selfCollide>true</selfCollide>
  </gazebo>

  <!-- Left elbow midle Joint -->
  <joint name="left_elbow_inword_to_midle" type="revolute">
    <parent link="left_elbow_inword"/>
    <child link="left_elbow_midle"/>
    <origin xyz="0 -0.012 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="1" friction="2"/>
    <limit lower="0" upper="1.9" effort="500" velocity="1.0"/>
  </joint>

  <link name="left_elbow_midle">
    <visual>
      <geometry>
        <mesh filename="file:///home/shreyas/ros2_ws/src/my_robot_description/meshes/left_arm/left_elbow_midle.stl" scale="0.15 0.15 0.15"/>
