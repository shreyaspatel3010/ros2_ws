  <!-- Left elbow to forarm upper Joint -->
  <joint name="left_elbow_midle_forarm_upper" type="fixed">
    <parent link="left_elbow_midle"/>
    <child link="left_elbow_to_forarm_upper"/>
    <origin xyz="0 0.0065 -0.0645" rpy="0 0 0"/>
    <axis xyz="0 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="500" velocity="1.0"/>
  </joint>

  <link name="left_elbow_to_forarm_upper">
