  </link>

  <gazebo reference="left_forarm_cover">
      <selfCollide>true</selfCollide>
  </gazebo>

  <!-- Left bisecp to wrist Joint -->
  <joint name="left_forarm_to_wrist" type="revolute">
    <parent link="Left_forarm_internal_support"/>
    <child link="left_wrist"/>
    <origin xyz="0 0.0015 -0.061" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
