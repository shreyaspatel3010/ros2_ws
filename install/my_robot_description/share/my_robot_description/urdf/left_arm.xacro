  <!-- Left forarm cover joint -->
  <joint name="left_internal_support_to_cover" type="fixed">
    <parent link="Left_forarm_internal_support"/>
    <child link="left_forarm_cover"/>
    <origin xyz="0 0.001 -0.001" rpy="0 0 0"/>
    <axis xyz="0 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="500" velocity="1.0"/>
