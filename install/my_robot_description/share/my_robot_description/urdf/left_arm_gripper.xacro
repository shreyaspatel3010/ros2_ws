<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="hruh">

  
  <!-- Left palm joint -->
  <joint name="left_wrist_to_palm" type="fixed">
    <parent link="left_wrist"/>
    <child link="left_palm"/>
    <origin xyz="0 0 -0.04" rpy="0 0 0"/>
    <axis xyz="0 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="500" velocity="1.0"/>
  </joint>

  <link name="left_palm">
    <visual>
      <geometry>
        <mesh filename="file:///home/shreyas/ros2_ws/src/my_robot_description/meshes/left_arm/left_palm.stl" scale="0.15 0.15 0.15"/>
      </geometry>
      <material name="grey" />
    </visual>
    <collision>
      <geometry>
        <mesh filename="file:///home/shreyas/ros2_ws/src/my_robot_description/meshes/left_arm/left_palm.stl" scale="0.15 0.15 0.15"/>
      </geometry>
    </collision>
    
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.0015" ixy="0.0" ixz="0.0" iyy="0.0015" iyz="0.0" izz="0.001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </inertial>
  </link>

  <gazebo reference="left_palm">
      <selfCollide>true</selfCollide>
  </gazebo>

  <!-- Left palm to thomb joint -->
  <joint name="left_palm_to_thomb" type="revolute">
    <parent link="left_palm"/>
    <child link="left_thomb_to_palm"/>
    <origin xyz="-0.021 0 0.018" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="1" friction="2"/>
    <limit lower="-1.8" upper="0" effort="500" velocity="1.0"/>
  </joint>

  <link name="left_thomb_to_palm">
    <visual>
      <geometry>
        <mesh filename="file:///home/shreyas/ros2_ws/src/my_robot_description/meshes/left_arm/left_thomb_to_palm.stl" scale="0.15 0.15 0.15"/>
      </geometry>
      <material name="grey" />
    </visual>
    <collision>
      <geometry>
        <mesh filename="file:///home/shreyas/ros2_ws/src/my_robot_description/meshes/left_arm/left_thomb_to_palm.stl" scale="0.15 0.15 0.15"/>
      </geometry>
    </collision>
    
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0006" ixy="0.0" ixz="0.0" iyy="0.0006" iyz="0.0" izz="0.0005"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </inertial>
  </link>

  <!-- Left thomb to thomb midle joint -->
  <joint name="left_thomb_to_thomb_middle" type="revolute">
    <parent link="left_thomb_to_palm"/>
    <child link="left_thomb_midle"/>
    <origin xyz="-0.02 0 0.0017" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="1" friction="2"/>
    <limit lower="-0.9" upper="0" effort="500" velocity="1.0"/>
  </joint>

  <link name="left_thomb_midle">
    <visual>
      <geometry>
        <mesh filename="file:///home/shreyas/ros2_ws/src/my_robot_description/meshes/left_arm/left_thomb_midle.stl" scale="0.15 0.15 0.15"/>
