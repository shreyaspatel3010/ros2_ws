  </link>

  <!-- Left thomb midle to thomb upper joint -->
  <joint name="left_thomb_middle_to_thomb_upper" type="revolute">
    <parent link="left_thomb_midle"/>
    <child link="left_thomb_upper"/>
    <origin xyz="-0.0259 0 -0.001" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="1" friction="2"/>
    <limit lower="-1.0" upper="0" effort="500" velocity="1.0"/>
