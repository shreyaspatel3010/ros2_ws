    <!-- Left palm  to finger3 lower -->
    <plugin filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
      <joint_name>left_palm_to_finger3_lower</joint_name>
      <p_gain>300</p_gain><i_gain>2</i_gain><d_gain>3</d_gain>
      <i_min>-6</i_min><i_max>6</i_max>
    </plugin>

    <!-- Left palm  to finger4 lower -->
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>left_palm_to_finger4_lower</joint_name>
      <p_gain>300</p_gain><i_gain>2</i_gain><d_gain>3</d_gain>
      <i_min>-6</i_min><i_max>6</i_max>
    </plugin>
  </gazebo>





</robot>